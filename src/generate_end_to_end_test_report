"""
generate_end_to_end_test_report.py

Runs the full chain -- Raw data -> Python -> PostgreSQL -> SQL --
against whatever is currently in data/raw/, and writes a real
Test/Expected/Actual/Status table to docs/end-to-end-test.md, per
Phase 2 Day 8.

The "Dashboard" row cannot be automated -- it requires manually
checking Power BI -- so it's left as a placeholder for you to fill
in by hand after connecting Power BI and confirming data displays
correctly.

Run:
    cd src
    python generate_end_to_end_test_report.py
"""

from pathlib import Path
from datetime import datetime
from sqlalchemy import text

from extract import extract_all
from transform import transform_all
from validate import validate_all
from load import load_all
from config import get_engine

BASE_DIR = Path(__file__).resolve().parent.parent
DOCS_PATH = BASE_DIR / "docs" / "end-to-end-test.md"
SCHEMA_PATH = BASE_DIR / "sql" / "schema.sql"


def main():
    rows = []  # (test, expected, actual, status)

    # 1. Extraction
    try:
        raw = extract_all()
        total_extracted = sum(len(df) for df in raw.values())
        rows.append(("Extraction", "Data loaded",
                     f"{total_extracted:,} total records extracted across 5 files", "Pass"))
    except Exception as e:
        rows.append(("Extraction", "Data loaded", f"FAILED: {e}", "Fail"))
        _write_report(rows)
        print(f"Wrote {DOCS_PATH} -- stopped early, extraction failed")
        return

    # 2. Validation
    try:
        clean = transform_all(raw)
        validated, report = validate_all(clean)
        if report.issues:
            issue_summary = "; ".join(
                f"{i['table']}.{i['check']}: {i['rows_affected']}" for i in report.issues
            )
            actual = f"Detected: {issue_summary}"
        else:
            actual = "Checks ran; no invalid records found in this dataset"
        rows.append(("Validation", "Invalid records detected", actual, "Pass"))
    except Exception as e:
        rows.append(("Validation", "Invalid records detected", f"FAILED: {e}", "Fail"))
        _write_report(rows)
        print(f"Wrote {DOCS_PATH} -- stopped early, validation failed")
        return

    # 3. Database
    try:
        load_results = load_all(validated, schema_path=str(SCHEMA_PATH))
        total_loaded = sum(r.get("records_inserted", 0) for r in load_results.values())
        failed_tables = [t for t, r in load_results.items() if r["status"] == "error"]
        if failed_tables:
            rows.append(("Database", "Records loaded",
                        f"{total_loaded:,} loaded; FAILED tables: {failed_tables}", "Fail"))
        else:
            rows.append(("Database", "Records loaded",
                        f"{total_loaded:,} records loaded across 5 tables", "Pass"))
    except Exception as e:
        rows.append(("Database", "Records loaded", f"FAILED: {e}", "Fail"))
        _write_report(rows)
        print(f"Wrote {DOCS_PATH} -- stopped early, load failed")
        return

    # 4. Analytics
    try:
        engine = get_engine()
        with engine.connect() as conn:
            total_students = conn.execute(text("SELECT COUNT(*) FROM students")).scalar()
            avg_score = conn.execute(text("SELECT ROUND(AVG(score), 1) FROM results")).scalar()
        rows.append(("Analytics", "Query executes",
                    f"total_students={total_students}, overall_avg_score={avg_score}", "Pass"))
    except Exception as e:
        rows.append(("Analytics", "Query executes", f"FAILED: {e}", "Fail"))

    # 5. Dashboard -- cannot be automated, needs manual Power BI check
    rows.append(("Dashboard", "Data displayed",
                "[fill in manually after connecting Power BI]", "[Pass/Fail]"))

    _write_report(rows)
    print(f"Wrote {DOCS_PATH}")


def _write_report(rows):
    out = ["# End-to-end test\n"]
    out.append(
        f"Generated by `src/generate_end_to_end_test_report.py` on "
        f"{datetime.now():%Y-%m-%d %H:%M}, running the real pipeline "
        "against the data currently in `data/raw/`. All rows except "
        "Dashboard are computed automatically -- Dashboard requires a "
        "manual check in Power BI.\n"
    )
    out.append("| Test | Expected | Actual | Status |")
    out.append("|---|---|---|---|")
    for test, expected, actual, status in rows:
        out.append(f"| {test} | {expected} | {actual} | {status} |")
    out.append("")
    DOCS_PATH.parent.mkdir(exist_ok=True)
    DOCS_PATH.write_text("\n".join(out), encoding="utf-8")


if __name__ == "__main__":
    main()
